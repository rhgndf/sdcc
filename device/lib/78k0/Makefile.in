# libc/78k0 Makefile

VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@

LIB_TYPE = @LIB_TYPE@

SCC = $(top_builddir)/bin/sdcc -m78k0
SAS = $(top_builddir)/bin/sdas78k0

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/78k0

include $(srcdir)/../incl.mk

K78K0_FLOAT = $(COMMON_FLOAT)
K78K0_LONGLONG = $(COMMON_LONGLONG)
K78K0_SDCC = $(filter-out _memcmp.c _memset.c _strncmp.c,$(COMMON_SDCC)) \
  __itoa.c \
  __ltoa.c \
  _strcpy.c \
  _memmove.c \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  vprintf.c

K78K0_OBJECTS = $(patsubst %.c,%.rel,$(K78K0_FLOAT) $(K78K0_LONGLONG) $(K78K0_SDCC))

OBJ = setjmp.rel heap.rel _memcmp.rel _memcpy.rel _memset.rel _strlen.rel _strnlen.rel _strcmp.rel _strncmp.rel _mulchar.rel _mulint.rel _mulint2long.rel _mullong.rel _mullonglong.rel _divchar.rel _divuint.rel _divsint.rel _divulong.rel _divslong.rel _divlonglong.rel
LIB = 78k0.lib
CC = $(SCC)
AS = $(SAS)
ASFLAGS = -plosgff
CFLAGS = -I$(srcdir)/../../include -I. --std-c2x

all: $(PORTDIR)/$(LIB)

$(PORTDIR):
	mkdir -p $(PORTDIR)

$(PORTDIR)/$(LIB): $(PORTDIR) $(OBJ) $(K78K0_OBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(K78K0_OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(top_builddir)/bin/sdar -rcSD $@ $(OBJ) $(K78K0_OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(top_builddir)/bin/sdar -rcD $@ $(OBJ) $(K78K0_OBJECTS)
    else
	rm -f $@
	for i in $(basename $(OBJ) $(K78K0_OBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(K78K0_OBJECTS) $(PORTDIR)
    endif
  endif
endif

%.rel: %.c
	$(CC) $(CFLAGS) -c $<

%.rel: %.s
	@# TODO: sdas should place its output in the current dir
	test $(srcdir) = . || cp $< .
	-$(AS) $(ASFLAGS) $(notdir $<)
	test $(srcdir) = . || rm $(notdir $<)

%.rel: ../%.c
	$(CC) $(CFLAGS) -c $<

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/78k0/Makefile
