// The indexed [HL+byte] form is one byte longer than the native [HL] form.

replace restart {
	%1	a,[hl+0x00]
} by {
	%1	a,[hl]
} if same(%1 'mov' 'add' 'addc' 'sub' 'subc' 'and' 'or' 'xor' 'cmp' 'xch')

replace restart {
	mov	[hl+0x00],a
} by {
	mov	[hl],a
}

// Remove the second half of register round-trips. MOV and MOVW do not alter flags.

replace {
	mov	a,x
	mov	x,a
} by {
	mov	a,x
}

replace {
	mov	x,a
	mov	a,x
} by {
	mov	x,a
}

replace {
	mov	a,b
	mov	b,a
} by {
	mov	a,b
}

replace {
	mov	b,a
	mov	a,b
} by {
	mov	b,a
}

replace {
	mov	a,c
	mov	c,a
} by {
	mov	a,c
}

replace {
	mov	c,a
	mov	a,c
} by {
	mov	c,a
}

replace {
	movw	ax,bc
	movw	bc,ax
} by {
	movw	ax,bc
}

replace {
	movw	bc,ax
	movw	ax,bc
} by {
	movw	bc,ax
}

replace {
	movw	ax,de
	movw	de,ax
} by {
	movw	ax,de
}

replace {
	movw	de,ax
	movw	ax,de
} by {
	movw	de,ax
}

replace {
	movw	ax,hl
	movw	hl,ax
} by {
	movw	ax,hl
}

replace {
	movw	hl,ax
	movw	ax,hl
} by {
	movw	hl,ax
}

// MOV and MOVW do not alter flags, so repeated loads of the same register or
// immediate value have no observable effect. Restrict operands to registers
// here: repeating a volatile memory read must not be removed.

replace restart {
	mov	%1,%2
	mov	%1,%2
} by {
	mov	%1,%2
} if same(%1 'a' 'x' 'b' 'c'), same(%2 'a' 'x' 'b' 'c')

replace restart {
	mov	%1,#%2
	mov	%1,#%2
} by {
	mov	%1,#%2
} if same(%1 'a' 'x' 'b' 'c')

replace restart {
	movw	%1,%2
	movw	%1,%2
} by {
	movw	%1,%2
} if same(%1 'ax' 'bc' 'de' 'hl'), same(%2 'ax' 'bc' 'de' 'hl')

replace restart {
	movw	%1,#%2
	movw	%1,#%2
} by {
	movw	%1,#%2
} if same(%1 'ax' 'bc' 'de' 'hl')

// Discard a side-effect-free AX load when the next instruction replaces AX.
// Do not match memory sources, since they may be volatile.

replace restart {
	movw	ax,%1
	movw	ax,%2
} by {
	movw	ax,%2
} if same(%1 'bc' 'de' 'hl' 'sp')

replace restart {
	movw	ax,#%1
	movw	ax,%2
} by {
	movw	ax,%2
}

replace restart {
	movw	ax,%1
	movw	ax,#%2
} by {
	movw	ax,#%2
} if same(%1 'bc' 'de' 'hl' 'sp')

replace restart {
	movw	ax,#%1
	movw	ax,#%2
} by {
	movw	ax,#%2
}

replace restart {
	movw	ax,%1
	movw	ax,#%2 + %3
} by {
	movw	ax,#%2 + %3
} if same(%1 'bc' 'de' 'hl' 'sp')

replace restart {
	movw	ax,#%1
	movw	ax,#%2 + %3
} by {
	movw	ax,#%2 + %3
}

replace restart {
	movw	ax,#%1 + %2
	movw	ax,#%3
} by {
	movw	ax,#%3
}

replace restart {
	movw	ax,#%1 + %2
	movw	ax,#%3 + %4
} by {
	movw	ax,#%3 + %4
}

// A branch to the immediately following label has no effect. The absolute
// form needs a separate rule because '!' is part of its operand syntax.

replace restart {
	br	!%1
%1:
} by {
%1:
} if labelRefCountChange(%1 -1)

replace restart {
	%1	%2
%2:
} by {
%2:
} if same(%1 'br' 'bc' 'bnc' 'bz' 'bnz'), labelRefCountChange(%2 -1)
